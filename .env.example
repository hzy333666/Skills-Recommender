# GitHub Personal Access Token (用于 GitHub Search API)
# 生成地址: https://github.com/settings/tokens
# 需要权限: public_repo (读取公开仓库)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI API 配置（OpenAI 兼容格式）
# 示例: Mimo API
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Server酱 微信推送 (https://sct.ftqq.com/)
SERVERCHAN_SENDKEY=your_sendkey_here
